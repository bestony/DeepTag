# Copy this file to `.env` and adjust as needed:
#
#   cp .env.example .env
#
# `.env` is git-ignored — never commit real secrets. Values already present in
# the real environment take precedence, so a container's configuration is never
# shadowed by this file. Every variable below is optional; the listed value is
# the default that applies when it is unset.

# Port the HTTP server listens on. Must be an integer in 0-65535.
PORT=3000

# Bind address. Defaults to loopback so the dev server is not reachable from the
# local network. Set 0.0.0.0 in containers, otherwise nothing outside can reach it.
HOST=127.0.0.1

# Log verbosity: debug | info | warn | error | silent
# Defaults to `debug`, or `info` when NODE_ENV=production.
LOG_LEVEL=debug

# development | production
# `production` also narrows the default log level to `info`.
NODE_ENV=development

# Directory holding operator-editable state. Relative paths resolve against the
# working directory. The agent reads AGENTS.md and MEMORY.md from here at
# startup; both are optional, and a missing or empty file simply adds nothing to
# the system prompt. The directory itself need not exist.
DATA_DIR=data

# --- Lark / Feishu bot -------------------------------------------------------
# Credentials from the app's "Credentials & Basic Info" page in the developer
# console. Leave both unset to run the HTTP server without the bot; they must be
# set together, or the bot stays disabled and a warning is logged.
#
# The app needs the `im:message` scope, the `im.message.receive_v1` event
# subscription, and "Long Connection" (WebSocket) selected as the event
# delivery mode — no public callback URL is required.
LARK_APP_ID=
LARK_APP_SECRET=

# Which deployment to talk to: feishu (mainland China) | lark (international)
LARK_DOMAIN=feishu

# --- Agent / DeepSeek --------------------------------------------------------
# API key from https://platform.deepseek.com. Without it the bot still receives
# messages but answers that it is not configured.
DEEPSEEK_API_KEY=

# Model id from the DeepSeek catalog: deepseek-v4-flash | deepseek-v4-pro
AGENT_MODEL=deepseek-v4-flash

# System prompt handed to the agent. Unset uses a built-in chat-oriented default.
# AGENT_SYSTEM_PROMPT=

# Milliseconds before an in-flight turn is aborted, 1000-600000. This is a
# backstop against a hung request blocking a chat, not a latency target.
AGENT_TIMEOUT_MS=120000
